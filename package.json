    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
