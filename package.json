{
  "name": "ehsan-ehrari-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "vite build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
